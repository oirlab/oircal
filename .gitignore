# Starting from: https://github.com/Keck-DataReductionPipelines/KPF-Pipeline/blob/master/.gitignore

# --- General -----------------------------------------------------------------
outputs/
logs/
receipts/
*.npy
*.log
*~
.DS_Store

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
.python-version

# C extensions
*.so

# Cython-generated C file (regenerated at build time)
*.c

# --- Packaging / build -------------------------------------------------------
/build/
/dist/
/downloads/
/develop-eggs/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
*.egg
.installed.cfg
pip-log.txt
pip-delete-this-directory.txt

# Version file is autogenerated
_version.py

# --- Environments ------------------------------------------------------------
.env
.venv/
venv/
env/
ENV/

# --- Testing / coverage ------------------------------------------------------
.pytest_cache/
.hypothesis/
.tox/
htmlcov/
.coverage
.coverage.*
.cache
coverage.xml
*.cover

# Unit test outputs (e.g. saved Plotly previews from stellar RV tests)
tests/output/

# --- Linters / type checkers -------------------------------------------------
.mypy_cache/
.ruff_cache/

# --- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints/
*_local.ipynb

# --- Documentation (Sphinx) --------------------------------------------------
docs/_build/
docs/build/
docs/html
docs/doctrees
**/api/generated/**
# Generated at Sphinx conf import from _static/notebooks/*.ipynb
docs/source/_static/basic_usage_notebook_embed.js
docs/source/_static/notebook_embeds*.js

# --- IDEs / editors ----------------------------------------------------------
.idea/
.vscode/
.cursor/
.spyderproject
.spyproject
.ropeproject

# --- Data / simulation outputs -----------------------------------------------
# Local E2E / perf outputs (large FITS; generated by run_e2e_sim)
test_data/

# Skip all FITS files...
*.fits

# Claude instructions
CLAUDE.md